# Data cache — immutable Parquet, regenerated from ingest/, never committed.
# No .gitkeep placeholders: git cannot re-include a file whose parent directory
# is excluded, so the negations that used to sit here never applied. store.py
# creates each partition directory on write, so a fresh clone needs nothing.
data/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Env / tooling
.venv/
.python-version
.uv/
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Notebooks
.ipynb_checkpoints/

# Editors / OS
.DS_Store
.vscode/
.idea/

# Secrets
.env
*.env.local

# Next.js frontend
web/node_modules/
web/.next/
web/out/
web/next-env.d.ts
web/.env*.local
