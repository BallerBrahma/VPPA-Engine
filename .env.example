# Copy to .env and fill in. .env is gitignored; never commit real keys.

# NREL — PVWatts weather (NSRDB). https://developer.nrel.gov/signup/
NREL_API_KEY=
NREL_API_EMAIL=

# gridstatus.io — historical ERCOT nodal prices. https://www.gridstatus.io/
# Only needed for resource-node prices; hub and load-zone history is free
# from ERCOT's own archive.
GRIDSTATUS_API_KEY=

# EIA — solar fleet capacity for penetration. https://www.eia.gov/opendata/register.php
EIA_API_KEY=
